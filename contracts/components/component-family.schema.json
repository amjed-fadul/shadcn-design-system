{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adc.local/contracts/components/component-family.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "source", "evidence", "exports", "unresolved"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "source": { "$ref": "#/$defs/source" },
    "evidence": { "type": "object", "additionalProperties": { "$ref": "#/$defs/evidence" } },
    "exports": { "type": "array", "items": { "$ref": "#/$defs/export" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": { "kind": { "enum": ["canonical-source", "inherited-interface", "runtime-test", "token-contract"] }, "source": { "type": "string" } }
    },
    "refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "structured": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["boolean", "string", "number"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "values"], "properties": { "kind": { "const": "enum" }, "values": { "type": "array", "items": { "type": "string" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "item"], "properties": { "kind": { "const": "array" }, "item": { "$ref": "#/$defs/structured" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "members"], "properties": { "kind": { "const": "union" }, "members": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/structured" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "typeText"], "properties": { "kind": { "const": "typescript" }, "typeText": { "type": "string" } } }
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalPath", "canonicalBlobSha", "implementationKind"],
      "properties": {
        "canonicalPath": { "type": "string" }, "canonicalBlobSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "implementationKind": { "type": "string" },
        "upstreamPath": { "type": "string" }, "upstreamBlobSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "localProp": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "required", "type", "evidenceRefs"],
      "properties": {
        "name": { "type": "string" }, "required": { "type": "boolean" }, "type": { "$ref": "#/$defs/structured" }, "typeText": { "type": "string" },
        "default": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] }, "evidenceRefs": { "$ref": "#/$defs/refs" }
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["propName", "default", "replacesHost", "childCardinality", "forwardsProps", "childRequires", "refForwarding", "evidenceRefs"],
      "properties": {
        "propName": { "type": "string" }, "default": { "type": "boolean" }, "replacesHost": { "type": "boolean" },
        "childCardinality": { "type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": { "min": { "type": "integer", "minimum": 0 }, "max": { "type": "integer", "minimum": 0 } } },
        "forwardsProps": { "type": "boolean" }, "childRequires": { "type": "array", "items": { "type": "string" } }, "refForwarding": { "enum": ["supported", "required", "unresolved"] }, "evidenceRefs": { "$ref": "#/$defs/refs" }
      }
    },
    "composition": {
      "type": "object", "additionalProperties": false, "required": ["requires", "provides", "hardConstraints"],
      "properties": { "requires": { "type": "array", "items": { "type": "string" } }, "provides": { "type": "array", "items": { "type": "string" } }, "hardConstraints": { "type": "array", "items": { "type": "string" } } }
    },
    "state": {
      "type": "object", "additionalProperties": false, "required": ["name", "evidenceRefs"],
      "anyOf": [
        { "required": ["controlledProp"], "properties": { "controlledProp": { "type": "string" } } },
        { "required": ["defaultProp"], "properties": { "defaultProp": { "type": "string" } } },
        { "required": ["changeEventProp"], "properties": { "changeEventProp": { "type": "string" } } }
      ],
      "properties": { "name": { "type": "string" }, "controlledProp": { "type": "string" }, "defaultProp": { "type": "string" }, "changeEventProp": { "type": "string" }, "evidenceRefs": { "$ref": "#/$defs/refs" } }
    },
    "apiCondition": {
      "type": "object", "additionalProperties": false, "required": ["propName", "equals"],
      "properties": { "propName": { "type": "string" }, "equals": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } }
    },
    "conditionalApiCondition": {
      "oneOf": [
        { "$ref": "#/$defs/apiCondition" },
        { "type": "object", "additionalProperties": false, "required": ["propName", "presence"], "properties": { "propName": { "type": "string" }, "presence": { "enum": ["present", "absent"] } } }
      ]
    },
    "tokenCondition": {
      "oneOf": [
        { "$ref": "#/$defs/tokenConditionAtom" },
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/tokenConditionAtom" } } } }
      ]
    },
    "tokenConditionAtom": {
      "oneOf": [
        { "$ref": "#/$defs/apiCondition" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["subject", "path", "propName", "equals"],
          "properties": {
            "subject": { "enum": ["data", "aria"] }, "path": { "$ref": "#/$defs/tokenConditionPath" },
            "propName": { "type": "string" }, "equals": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] }
          }
        }
      ]
    },
    "tokenConditionPath": {
      "oneOf": [
        { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "self" } } } },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tokenConditionPathSegment" } }
      ]
    },
    "tokenConditionPathSegment": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["has", "in"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["group", "peer"] }, "name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" } } }
      ]
    },
    "conditional": {
      "type": "object", "additionalProperties": false,
      "required": ["when", "propRefinements", "eventRefinements", "stateChannels", "evidenceRefs"],
      "properties": { "when": { "$ref": "#/$defs/conditionalApiCondition" }, "propRefinements": { "type": "array", "items": { "$ref": "#/$defs/propRefinement" } }, "eventRefinements": { "type": "array", "items": { "$ref": "#/$defs/eventRefinement" } }, "stateChannels": { "type": "array", "items": { "$ref": "#/$defs/state" } }, "evidenceRefs": { "$ref": "#/$defs/refs" } }
    },
    "propRefinement": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["propName", "availability", "required", "type", "evidenceRefs"], "properties": { "propName": { "type": "string" }, "availability": { "const": "available" }, "required": { "type": "boolean" }, "type": { "$ref": "#/$defs/structured" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
        { "type": "object", "additionalProperties": false, "required": ["propName", "availability", "evidenceRefs"], "properties": { "propName": { "type": "string" }, "availability": { "const": "unavailable" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } }
      ]
    },
    "eventRefinement": {
      "type": "object", "additionalProperties": false, "required": ["eventPropName", "payload", "evidenceRefs"],
      "properties": { "eventPropName": { "type": "string" }, "payload": { "$ref": "#/$defs/structured" }, "evidenceRefs": { "$ref": "#/$defs/refs" } }
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["propName", "evidenceRefs"],
      "properties": { "propName": { "type": "string" }, "payload": { "$ref": "#/$defs/structured" }, "evidenceRefs": { "$ref": "#/$defs/refs" } }
    },
    "tokenSourceContext": {
      "type": "object", "additionalProperties": false, "required": ["applicability"],
      "properties": {
        "applicability": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "target": { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "const": "pseudo-element" }, "name": { "enum": ["after", "before"] } } }
      },
      "anyOf": [
        { "properties": { "applicability": { "type": "array", "minItems": 1 } } },
        { "required": ["target"], "properties": { "target": { "type": "object" } } }
      ]
    },
    "token": {
      "type": "object", "additionalProperties": false, "required": ["tokenId", "evidenceRefs"],
      "properties": { "tokenId": { "type": "string" }, "when": { "$ref": "#/$defs/tokenCondition" }, "sourceContext": { "$ref": "#/$defs/tokenSourceContext" }, "viaDerivedRule": { "type": "object", "additionalProperties": false, "required": ["id", "multiplier"], "properties": { "id": { "type": "string" }, "multiplier": { "type": "number" } } }, "evidenceRefs": { "$ref": "#/$defs/refs" } }
    },
    "inheritedPropDefault": {
      "type": "object", "additionalProperties": false, "required": ["propName", "value", "evidenceRefs"],
      "properties": { "propName": { "type": "string" }, "value": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] }, "evidenceRefs": { "$ref": "#/$defs/refs" } }
    },
    "renderFlowGuardSource": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "propName"], "properties": { "kind": { "const": "prop" }, "propName": { "type": "string" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "collectionId"], "properties": { "kind": { "const": "collection" }, "collectionId": { "type": "string" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "collectionId", "itemProperty", "index", "optionalItem"], "properties": { "kind": { "const": "collection-item-property" }, "collectionId": { "type": "string" }, "itemProperty": { "type": "string" }, "index": { "const": 0 }, "optionalItem": { "type": "boolean" } } }
    ] },
    "renderFlowGuard": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["op", "source"], "properties": { "op": { "enum": ["truthy", "falsy", "array"] }, "source": { "$ref": "#/$defs/renderFlowGuardSource" } } },
      { "type": "object", "additionalProperties": false, "required": ["op", "source", "optionalSource"], "properties": { "op": { "const": "empty" }, "source": { "$ref": "#/$defs/renderFlowGuardSource" }, "optionalSource": { "type": "boolean" } } },
      { "type": "object", "additionalProperties": false, "required": ["op", "source", "value"], "properties": { "op": { "enum": ["length-eq", "length-gt"] }, "source": { "$ref": "#/$defs/renderFlowGuardSource" }, "value": { "type": "integer", "minimum": 0 } } },
      { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/renderFlowGuard" } } } }
    ] },
    "collectionChoice": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["when", "source", "evidenceRefs"], "properties": { "when": { "$ref": "#/$defs/renderFlowGuard" }, "source": { "type": "object", "additionalProperties": false, "required": ["kind", "propName"], "properties": { "kind": { "enum": ["prop", "singleton-prop"] }, "propName": { "type": "string" } } }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
      { "type": "object", "additionalProperties": false, "required": ["source", "evidenceRefs"], "properties": { "source": { "type": "object", "additionalProperties": false, "required": ["kind", "propName"], "properties": { "kind": { "enum": ["prop", "singleton-prop"] }, "propName": { "type": "string" } } }, "evidenceRefs": { "$ref": "#/$defs/refs" } } }
    ] },
    "derivedCollection": { "type": "object", "additionalProperties": false, "required": ["id", "choices", "evidenceRefs"], "properties": { "id": { "type": "string", "minLength": 1 }, "choices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/collectionChoice" } }, "uniqueBy": { "type": "object", "additionalProperties": false, "required": ["itemProperty", "optionalItem", "retention", "evidenceRefs"], "properties": { "itemProperty": { "type": "string" }, "optionalItem": { "type": "boolean" }, "retention": { "const": "last-value-first-key-order" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
    "renderFlowContent": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["source", "propName"], "properties": { "source": { "const": "prop" }, "propName": { "type": "string" } } },
      { "type": "object", "additionalProperties": false, "required": ["source", "collectionId", "itemProperty", "index", "optionalItem"], "properties": { "source": { "const": "collection-item-property" }, "collectionId": { "type": "string" }, "itemProperty": { "type": "string" }, "index": { "const": 0 }, "optionalItem": { "type": "boolean" } } }
    ] },
    "renderFlowOutcome": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "absent" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "tree"], "properties": { "kind": { "const": "rendered" }, "tree": { "$ref": "#/$defs/renderingTree" }, "content": { "$ref": "#/$defs/renderFlowContent" } } }
    ] },
    "renderFlowBranch": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["when", "outcome", "evidenceRefs"], "properties": { "when": { "$ref": "#/$defs/renderFlowGuard" }, "outcome": { "$ref": "#/$defs/renderFlowOutcome" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
      { "type": "object", "additionalProperties": false, "required": ["otherwise", "outcome", "evidenceRefs"], "properties": { "otherwise": { "const": true }, "outcome": { "$ref": "#/$defs/renderFlowOutcome" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } }
    ] },
    "renderingFlow": { "type": "object", "additionalProperties": false, "required": ["collections", "branches"], "properties": { "collections": { "type": "array", "items": { "$ref": "#/$defs/derivedCollection" } }, "branches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/renderFlowBranch" } } } },
    "renderHost": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "tag"], "properties": { "kind": { "const": "intrinsic" }, "tag": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "interfaceId"], "properties": { "kind": { "const": "inherited-interface" }, "interfaceId": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "exportName"], "properties": { "kind": { "const": "component-export" }, "exportName": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "familyId", "exportName"], "properties": { "kind": { "const": "cross-family-export" }, "familyId": { "type": "string" }, "exportName": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "fragment" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "unresolved" } } }
      ]
    },
    "renderCondition": {
      "oneOf": [
        { "$ref": "#/$defs/apiCondition" },
        { "type": "object", "additionalProperties": false, "required": ["propName", "truthiness"], "properties": { "propName": { "type": "string" }, "truthiness": { "enum": ["truthy", "falsy"] } } },
        { "type": "object", "additionalProperties": false, "required": ["propName", "nullishness"], "properties": { "propName": { "type": "string" }, "nullishness": { "enum": ["nullish", "non-nullish"] } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "name", "equals"], "properties": { "source": { "const": "state" }, "name": { "type": "string" }, "equals": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "name", "truthiness"], "properties": { "source": { "const": "state" }, "name": { "type": "string" }, "truthiness": { "enum": ["truthy", "falsy"] } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "name", "nullishness"], "properties": { "source": { "const": "state" }, "name": { "type": "string" }, "nullishness": { "enum": ["nullish", "non-nullish"] } } },
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/renderCondition" } } } }
      ]
    },
    "renderValue": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["source", "value"], "properties": { "source": { "const": "literal" }, "value": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "name"], "properties": { "source": { "enum": ["prop", "state"] }, "name": { "type": "string" } } }
      ]
    },
    "renderChildRef": {
      "type": "object", "additionalProperties": false, "required": ["nodeId", "evidenceRefs"],
      "properties": { "nodeId": { "type": "string" }, "when": { "$ref": "#/$defs/renderCondition" }, "repeat": { "type": "object", "additionalProperties": false, "required": ["collectionId", "count", "evidenceRefs"], "properties": { "collectionId": { "type": "string" }, "count": { "enum": ["collection-length", "matching-items"] }, "itemWhen": { "type": "object", "additionalProperties": false, "required": ["op", "itemProperty", "optionalItem"], "properties": { "op": { "const": "truthy" }, "itemProperty": { "type": "string" }, "optionalItem": { "type": "boolean" } } }, "evidenceRefs": { "$ref": "#/$defs/refs" } } }, "evidenceRefs": { "$ref": "#/$defs/refs" } }
    },
    "renderDataAttribute": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["name", "source", "evidenceRefs"], "properties": { "name": { "type": "string" }, "source": { "const": "literal" }, "value": { "type": "string" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
        { "type": "object", "additionalProperties": false, "required": ["name", "source", "prop", "evidenceRefs"], "properties": { "name": { "type": "string" }, "source": { "const": "prop" }, "prop": { "type": "string" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
        { "type": "object", "additionalProperties": false, "required": ["name", "source", "evidenceRefs"], "properties": { "name": { "type": "string" }, "source": { "const": "primitive-state" }, "value": { "type": "string" }, "prop": { "type": "string" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
        { "type": "object", "additionalProperties": false, "required": ["name", "source", "condition", "evidenceRefs"], "properties": { "name": { "type": "string" }, "source": { "const": "derived-condition" }, "condition": { "$ref": "#/$defs/renderCondition" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
        { "type": "object", "additionalProperties": false, "required": ["name", "source", "condition", "whenTrue", "whenFalse", "evidenceRefs"], "properties": { "name": { "type": "string" }, "source": { "const": "conditional-value" }, "condition": { "$ref": "#/$defs/renderCondition" }, "whenTrue": { "$ref": "#/$defs/renderValue" }, "whenFalse": { "$ref": "#/$defs/renderValue" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } }
      ]
    },
    "renderNode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "host", "receivesPublicProps", "dataAttributes", "children", "evidenceRefs"],
      "properties": {
        "id": { "type": "string" }, "host": { "$ref": "#/$defs/renderHost" }, "receivesPublicProps": { "type": "boolean" },
        "dataAttributes": { "type": "array", "items": { "$ref": "#/$defs/renderDataAttribute" } },
        "derivedSpreads": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["source", "name", "evidenceRefs"], "properties": { "source": { "enum": ["prop", "state"] }, "name": { "type": "string" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/renderChildRef" } }, "evidenceRefs": { "$ref": "#/$defs/refs" }
      }
    },
    "renderingTree": {
      "type": "object", "additionalProperties": false,
      "required": ["rootNodeId", "publicPropsTargetNodeId", "nodes", "portalBoundaries"],
      "properties": { "rootNodeId": { "type": "string" }, "publicPropsTargetNodeId": { "type": "string" }, "nodes": { "type": "array", "items": { "$ref": "#/$defs/renderNode" } }, "portalBoundaries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["nodeId", "evidenceRefs"], "properties": { "nodeId": { "type": "string" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } } } }
    },
    "renderingAlternative": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["when", "rendering", "evidenceRefs"], "properties": { "when": { "$ref": "#/$defs/renderCondition" }, "rendering": { "$ref": "#/$defs/renderingTree" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
        { "type": "object", "additionalProperties": false, "required": ["otherwise", "rendering", "evidenceRefs"], "properties": { "otherwise": { "const": true }, "rendering": { "$ref": "#/$defs/renderingTree" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } }
      ]
    },
    "rendering": {
      "oneOf": [
        { "$ref": "#/$defs/renderingTree" },
        {
          "type": "object", "additionalProperties": false, "required": ["alternatives"],
          "properties": {
            "alternatives": {
              "oneOf": [
                { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/renderingAlternative" } },
                {
                  "type": "array", "minItems": 1, "maxItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["when", "rendering", "evidenceRefs"],
                    "properties": { "when": { "$ref": "#/$defs/renderCondition" }, "rendering": { "$ref": "#/$defs/renderingTree" }, "evidenceRefs": { "$ref": "#/$defs/refs" } }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "accessibility": {
      "type": "object", "additionalProperties": false, "required": ["feature", "owner", "mechanism", "evidenceRefs"],
      "properties": { "feature": { "type": "string" }, "owner": { "enum": ["native", "author", "component"] }, "mechanism": { "type": "string" }, "evidenceRefs": { "$ref": "#/$defs/refs" } }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["localProps", "inherits", "slots", "composition", "stateChannels", "conditionalApi", "events", "tokenDependencies", "rendering", "accessibility", "inheritedPropDefaults"],

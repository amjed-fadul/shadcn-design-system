{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adc.local/contracts/knowledge/knowledge-reference-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "references"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "locator", "locatorHint", "accessedOn"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["official-documentation", "official-standard", "canonical-source"] },
        "title": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "locatorHint": { "type": "string", "minLength": 1 },
        "accessedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
      }
    }
  }
}

        "accessibility": [
          {
            "feature": "native form semantics",
            "owner": "native",
            "mechanism": "root renders a native <form> element and adds no role; the browser exposes it as a form landmark only when the author names it with aria-label or aria-labelledby, so do not add role=\"form\", and name a form only when it is a meaningful landmark on the page",
            "evidenceRefs": [
              "source"
            ]
          },
          {
            "feature": "submit behavior",
            "owner": "native",
            "mechanism": "submitting is native browser form submission: a Button with type=\"submit\" inside the Form submits it, and the browser dispatches a submit event that reaches the onSubmit prop. Form adds no submit handler of its own; the caller's onSubmit decides what submitting does and calls event.preventDefault() when the application handles the submit itself. A native <button> (including Button) inside a form with no type attribute is a submit button by default, so give every non-submit Button type=\"button\"; InputGroupButton already defaults to type=\"button\"",
            "evidenceRefs": [
              "source"
            ]
          },
          {
            "feature": "Enter key behavior",
            "owner": "native",
            "mechanism": "pressing Enter in a form control such as a text or password Input submits the Form through the browser's implicit submission; Form adds no key handling. Whether Enter submits in a given form (for example one without a submit button and with several text fields) is decided by the browser, not by Form",
            "evidenceRefs": [
              "source"
            ]
          },
          {
            "feature": "native validation",
            "owner": "native",
            "mechanism": "the browser checks native constraints such as required, type=\"email\", pattern, min and max before submitting; while a control is invalid the submit event does not fire, so onSubmit is not called, and the browser reports the first invalid control. Set noValidate to skip this check when the author intentionally validates elsewhere. Application-specific validation (server checks, cross-field rules, async checks) is caller-owned",
            "evidenceRefs": [
              "source"
            ]
          },
          {
            "feature": "forwarded form props",
            "owner": "native",
            "mechanism": "standard form attributes pass through to the <form> element and are not duplicated as Form props: onSubmit, action, method, noValidate, autoComplete, encType, target, name and id",
            "evidenceRefs": [
              "source"
            ]
          },
          {
            "feature": "form controls and Field",
            "owner": "native",
            "mechanism": "controls inside the form belong to it: Field, FieldLabel, FieldDescription and FieldError relationships (htmlFor, aria-describedby, aria-invalid) are unchanged inside a Form, and a control needs a name to appear in the submitted data. Select contributes to the form data only when name is set on Select; its trigger stays a combobox and Radix renders a hidden native select for form participation",
            "evidenceRefs": [
              "source"
            ]
          },
          {
            "feature": "result and async ownership",
            "owner": "author",
            "mechanism": "Form does not manage validation state, focus invalid fields, perform server requests, run or track async work, or announce results. Show field errors with FieldError and aria-invalid, and put form-level progress or result text in a <Status> that is a sibling of the Form's controls (inside or beside the Form, never nested in another live region); the caller controls when that text changes",
            "evidenceRefs": [
              "source"
            ]
          }
        ],
        "inheritedPropDefaults": []
      }

        "accessibility": [
          {
            "feature": "figure name and description",
            "owner": "component",
            "mechanism": "The root figure is named by the title prop (aria-label) and described (aria-describedby) by a visually hidden one-sentence summary of the range and extremes plus the full data table with formatted values.",

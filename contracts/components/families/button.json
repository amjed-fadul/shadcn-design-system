          {
            "feature": "loading state",
            "owner": "component",
            "mechanism": "loading is caller-controlled: Button does not start, track, or finish async work, so the caller sets loading back to false when the work ends. While loading is true on the native button host, Button renders the governed Spinner before the label with data-icon=\"inline-start\", sets aria-busy=\"true\", and sets the native disabled attribute, so pointer, keyboard (Enter and Space), and form-submit activation are blocked. A disabled button leaves the tab order and cannot keep keyboard focus, so move focus deliberately if the flow needs it. A leading data-icon=\"inline-start\" child is hidden while loading so the Spinner takes its place, and a button whose data-size starts with icon shows only the Spinner in place of its icon, including InputGroupButton icon sizes; a button with no leading icon grows by the Spinner and its gap",
            "evidenceRefs": [
              "source"
            ]
          },
          {
            "feature": "loading accessible name",
            "owner": "component",
            "mechanism": "the Spinner rendered by loading has aria-hidden=\"true\" and drops its default role=\"status\" and aria-label=\"Loading\", so it adds no accessible-name text and no live-region announcement; the accessible name stays the button's own content or aria-label, for example \"Log in\"",
            "evidenceRefs": [
              "source"
            ]
          },
          {
            "feature": "loading label wording",
            "owner": "author",
            "mechanism": "keep the action label unchanged while loading, so Log in stays Log in rather than becoming Loading\u2026 or Logging in\u2026; aria-busy conveys the busy state. Loading does not announce completion or failure, so report the result with a caller-provided Status (or Status variant=\"error\" for an important failure) from the alert family",
            "evidenceRefs": [
              "source"
            ]
          },
          {
            "feature": "loading under asChild",
            "owner": "component",
            "mechanism": "loading is ignored when asChild is true, because the replacement child owns its content and disabled state; use the native button host for loading",
            "evidenceRefs": [
              "source"
            ]
          }
